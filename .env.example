# RECALL — AI Meeting Intelligence
# Copy this file to .env and fill in your actual keys.
# Never commit .env to version control.

# Required: Mistral API key for LLM summarization, extraction, and RAG chat.
# Obtain from https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Required only for Hindi/Hinglish transcription (Sarvam AI speech-to-text).
# Obtain from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional overrides (defaults shown):
# WHISPER_MODEL=small
# MISTRAL_MODEL=mistral-small-latest
# SARVAM_STT_MODEL=saaras:v2.5
